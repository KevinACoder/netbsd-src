# RK3568 lab: Intel Wireless-AC 7260 firmware for iwm(4) on the PCIe
# slots.  iwm loads <fwdir>/if_iwm/iwlwifi-7260-17.ucode via firmload(9)
# (the directory prefix is the driver name), and /libdata/firmware is in
# the default search path.  Source is the in-tree distribution copy.
COPY	${NETBSDSRCDIR}/external/intel-fw-public/iwl7260/dist/iwlwifi-7260-17.ucode	libdata/firmware/if_iwm/iwlwifi-7260-17.ucode

# RK3568 lab: rtw88(4) firmware for the Realtek RTL8821CU USB dongle.
# rtw88 loads <fwdir>/if_rtw88/rtw8821c_fw.bin the same way.
COPY	${NETBSDSRCDIR}/external/realtek/rtw88/dist/rtw8821c_fw.bin	libdata/firmware/if_rtw88/rtw8821c_fw.bin

# RK3568 lab: rtw89(4) firmware for the Realtek RTL8851BU USB dongle.
# The driver tries rtw8851b_fw-1.bin (format 1, with element segments)
# first and falls back to rtw8851b_fw.bin (fw.c iterates fw_format_max..0).
COPY	${NETBSDSRCDIR}/external/realtek/rtw89/dist/rtw8851b_fw-1.bin	libdata/firmware/if_rtw89/rtw8851b_fw-1.bin
COPY	${NETBSDSRCDIR}/external/realtek/rtw89/dist/rtw8851b_fw.bin	libdata/firmware/if_rtw89/rtw8851b_fw.bin

# RK3568 lab: rtw8189f(4) firmware for the RTL8189FTV SDIO module.
# Firmware is the vendor hal8188f_fw.c array_mp_8188f_fw_nic payload
# (20306 B, sig 0x88f1, fw_ver 0xe).
COPY	${NETBSDSRCDIR}/external/realtek/rtw8189f/dist/rtw8189f_fw.bin	libdata/firmware/if_rtw8189f/rtw8189f_fw.bin

# RK3568 lab: aic8800u(4) firmware for the AICSemi AIC8800D80 USB dongle.
# Non-IPC u02 variant per the Linux ground truth (loader downloads
# fmacfw/adid/patch to RAM, the app stage reads lmacfw_rf + userconfig).
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/fmacfw_8800d80_u02.bin	libdata/firmware/aic8800u/fmacfw_8800d80_u02.bin
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/fw_adid_8800d80_u02.bin	libdata/firmware/aic8800u/fw_adid_8800d80_u02.bin
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/fw_patch_8800d80_u02.bin	libdata/firmware/aic8800u/fw_patch_8800d80_u02.bin
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/fw_patch_table_8800d80_u02.bin	libdata/firmware/aic8800u/fw_patch_table_8800d80_u02.bin
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/lmacfw_rf_8800d80_u02.bin	libdata/firmware/aic8800u/lmacfw_rf_8800d80_u02.bin
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/aic_userconfig_8800d80.txt	libdata/firmware/aic8800u/aic_userconfig_8800d80.txt
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/aic_powerlimit_8800d80.txt	libdata/firmware/aic8800u/aic_powerlimit_8800d80.txt
COPY	${NETBSDSRCDIR}/external/aicsemi/aic8800/dist/calibmode_8800d80.bin	libdata/firmware/aic8800u/calibmode_8800d80.bin
