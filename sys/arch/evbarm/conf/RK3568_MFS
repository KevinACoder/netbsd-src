#	$NetBSD$
#
#	RK3568 ramdisk (miniroot-in-kernel) driver-debug line.
#
#	Modeled on the FreeBSD mfsBSD lane: a GENERIC64 kernel with a
#	fixed-size memory-disk root embedded via mdsetimage(8).  Boots over
#	TFTP + U-Boot booti with no bootargs; root is the embedded md0a
#	miniroot, console from the DTB stdout-path.
#
#	Everything from GENERIC64 stays enabled ("都打开") so the driver
#	matrix is as broad as possible for bring-up.  Only the memory-disk
#	root options are layered on top.

include	"arch/evbarm/conf/GENERIC64"

# RK3568 bring-up SoC (fixed-rate CRU stub + platform glue)
options 	SOC_RK3568

# RK3568 SATA / PCIe lanes (NanoEng combo PHY, SATA + PCIe modes).
# pass 8: fdt default-pass attach order follows the node's phandle
# value (fdt_get_order), not document order - on this dtb pcie2x1 has a
# lower phandle than combphy2 and would attach (and fail to find its
# phy) before the phy controller is registered.  Pin the combphys to
# pass 8 so all three lanes are registered before the root complexes.
rkcombphy*	at fdt? pass 8

# RK3568 USB2 PHY (dwc3 xHCI lanes, USB domain bring-up)
rkusb2phy*	at fdt?

# RK3568 PCIe3 PHY (pcie30phy SRAM firmware) and DWC PCIe hosts.
# The phy attaches in pass 9 so it registers before the root complexes;
# the rkdwpcie line stays after rkcombphy (same default pass, fdt
# children attach in document order and combphy2 must exist first).
rk30pciephy*	at fdt? pass 9
rkdwpcie*	at fdt?

# Intel Wireless (802.11ac, PCIe): Dual Band Wireless-AC 7260 in the
# x4 slot; firmware iwlwifi-7260-17.ucode baked into the miniroot.
iwm*		at pci? dev ? function ?

# iwm firmware-error dumps (iwm_nic_error) for the scan-time fatal
# firmware error investigation on this board.
options 	IWM_DEBUG

# Onboard I2C devices (i2c0 PMIC, i2c1 battery RTC + power monitor);
# rkiic/iic/cpufreqdt/rktsadc come in via GENERIC64.
rk809pmic*	at iic?
rx8025rtc*	at iic?
ina3221mon*	at iic?

# Ramdisk root (miniroot embedded with mdsetimage)
options 	MEMORY_DISK_IS_ROOT
options 	MEMORY_DISK_ROOT_SIZE=9216	# 9216 * 512 = 4608 KiB (ramdisk.fs + iwm fw)
options 	MEMORY_DISK_RBFLAGS=RB_SINGLE	# single-user: no device needed
no options 	MEMORY_DISK_DYNAMIC		# fixed layout, mdsetimage format
